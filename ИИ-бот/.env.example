# Скопируй в .env и заполни. Файл .env НЕ попадает в git.

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать: написать боту /myid)
ADMIN_IDS=

# --- ИИ (любой OpenAI-совместимый API) ---
# Вариант по умолчанию: OpenRouter, бесплатные модели с суффиксом :free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Основная модель и запасные (через запятую) - если основная лежит/лимит
AI_MODEL=deepseek/deepseek-chat-v3-0324:free
AI_FALLBACK_MODELS=deepseek/deepseek-r1-0528:free,meta-llama/llama-3.3-70b-instruct:free

# Другие бесплатные варианты:
# Groq:   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash

DB_PATH=barbershop.db
# Сколько последних сообщений диалога помнит ИИ
HISTORY_LIMIT=16
# Лимит сообщений от одного человека в минуту (защита от спама/лимитов API)
RATE_LIMIT_PER_MIN=8
